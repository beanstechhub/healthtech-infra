# Directus 11 — CMS headless único do grupo (cms.beanstech.com.br). Postgres ht_cms no br-db, mídia no OSS, login pelo BeansTech ID.
PUBLIC_URL:=https://cms.beanstech.com.br
KEY=DIRECTUS_KEY
SECRET=DIRECTUS_SECRET
DB_CLIENT:=pg
DB_HOST:=172.16.1.52
DB_PORT:=5432
DB_DATABASE:=ht_cms
DB_USER:=ht_cms
DB_PASSWORD=HT_CMS_DB_PASSWORD
ADMIN_EMAIL:=beanstechbrasil@gmail.com
ADMIN_PASSWORD=DIRECTUS_ADMIN_PASSWORD
# mídia → OSS (S3-compatible), endpoint interno = sem custo de tráfego
STORAGE_LOCATIONS:=oss
STORAGE_OSS_DRIVER:=s3
STORAGE_OSS_ROOT:=media
STORAGE_OSS_KEY=DIRECTUS_OSS_AK
STORAGE_OSS_SECRET=DIRECTUS_OSS_SK
STORAGE_OSS_BUCKET:=beanstech-cms-media
STORAGE_OSS_REGION:=sa-east-1
STORAGE_OSS_ENDPOINT:=https://oss-sa-east-1-internal.aliyuncs.com
STORAGE_OSS_FORCE_PATH_STYLE:=false
# login único
AUTH_PROVIDERS:=keycloak
AUTH_KEYCLOAK_DRIVER:=openid
AUTH_KEYCLOAK_CLIENT_ID:=directus
AUTH_KEYCLOAK_CLIENT_SECRET=KEYCLOAK_CLIENT_SECRET_DIRECTUS
AUTH_KEYCLOAK_ISSUER_URL:=https://id.beanstech.com.br/realms/beanstech/.well-known/openid-configuration
AUTH_KEYCLOAK_IDENTIFIER_KEY:=email
AUTH_KEYCLOAK_ALLOW_PUBLIC_REGISTRATION:=false
AUTH_KEYCLOAK_LABEL:=BeansTech ID
AUTH_KEYCLOAK_ICON:=key
# e-mail (Direct Mail) — senha SMTP ainda pendente no console
EMAIL_FROM:=no-reply@ativo.tech
EMAIL_TRANSPORT:=smtp
EMAIL_SMTP_HOST:=smtpdm-ap-southeast-1.aliyun.com
EMAIL_SMTP_PORT:=465
EMAIL_SMTP_SECURE:=true
EMAIL_SMTP_USER:=no-reply@ativo.tech
EMAIL_SMTP_PASSWORD=DIRECTMAIL_SMTP_PASSWORD
# operação
CACHE_ENABLED:=false
RATE_LIMITER_ENABLED:=true
RATE_LIMITER_POINTS:=60
RATE_LIMITER_DURATION:=1
CORS_ENABLED:=true
CORS_ORIGIN:=https://dodr.ai,https://app.dodr.ai,https://exame.tech,https://prontuario.tech,https://drogaria.tech,https://beanshealth.com.br,https://portaldodentista.ai,https://drhealth.tech,https://petiq.tech
LOG_LEVEL:=info
TELEMETRY:=false
WEBSOCKETS_ENABLED:=false
FILES_MAX_UPLOAD_SIZE:=50mb
TZ:=America/Sao_Paulo
