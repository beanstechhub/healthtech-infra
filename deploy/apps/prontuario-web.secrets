# Manifesto padrão (sites sem banco). Formato: ENV=NOME_NO_KMS  |  ENV:=literal
NODE_ENV:=production
# --- camada 1: RagJur/RagMed (Elasticsearch self-hosted no br-es, VPC) ---
RAGMED_ES_URL:=https://172.16.1.53:9200
RAGMED_ES_CA:=/etc/healthtech/ca/es-br.crt
NODE_EXTRA_CA_CERTS:=/etc/healthtech/ca/es-br.crt
RAGMED_ES_USER:=elastic
RAGMED_ES_PASSWORD=ESBR_SELFHOSTED_PASSWORD
# --- camada 2: Model Studio (DashScope intl, OpenAI-compatible) ---
QWEN_BASE_URL:=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=DASHSCOPE_API_KEY
QWEN_MODEL:=qwen-plus
DASHSCOPE_API_KEY=DASHSCOPE_API_KEY
# --- camada 3: fatos estruturados / identidade (PolarDB MySQL BR) ---
AUTH_MYSQL_URL=HT_AUTH_MYSQL_URL
# --- camada 4: modelos médicos CPU no Brasil (medpubr, VPC) ---
MEDPUBR_URL:=http://172.16.0.21:8300
# --- camada 5: especialista GPU (Singapura, gateway com token) ---
OLLAMA_CHAT_URLS:=http://172.16.1.51:8080
OLLAMA_URLS:=http://172.16.1.51:8080
OLLAMA_BASE_URL:=http://172.16.1.51:8080
OLLAMA_API_KEY=GPU_GATEWAY_TOKEN
OLLAMA_CHAT_MODEL:=medgemma:27b
OLLAMA_MODEL:=medgemma:27b
PHARMA_MODEL:=medgemma:27b
MEDGEMMA_MODEL:=medgemma:27b
COPILOT_PROVIDER:=ollama
NEXT_PUBLIC_API_URL:=https://api.prontuario.tech
EXCELLENCE_BASE_URL:=http://47.85.201.160:8000/v1
