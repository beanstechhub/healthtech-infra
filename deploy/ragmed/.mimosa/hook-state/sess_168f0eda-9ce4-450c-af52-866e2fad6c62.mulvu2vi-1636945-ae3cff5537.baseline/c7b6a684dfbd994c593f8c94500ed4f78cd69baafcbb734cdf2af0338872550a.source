#!/usr/bin/env python3
"""ragmed.ai — coletor 4: Protocolos do SUS / Ministério da Saúde + catálogo Dados Abertos.

Fontes oficiais:
  1. https://www.gov.br/saude/pt-br/assuntos/saude-de-a-z — protocolos, PCDT publicados
     pelo MS e guias da atenção básica (PDFs no padrão gov.br)
  2. https://apidadosabertos.saude.gov.br/ — API oficial do Dados Abertos do SUS
     (respondeu 200 em 28/09/2026); usada para descobrir datasets relevantes
  (o CKAN ckan-dadosabertos.saude.gov.br não resolve DNS neste ambiente — não é usado.)

uso: python3 coletor_sus_protocolos.py [--max N] [--com-api]
"""
import argparse
import json
import re
import sys
import time

from ragmed_common import PAUSE_S, extrair_links, fetch, fetch_pdf_doc, fonte_dir

SEMENTES = [
    "https://www.gov.br/saude/pt-br/assuntos/saude-de-a-z",
    "https://www.gov.br/saude/pt-br/assuntos/atencao-basica",
    "https://www.gov.br/conitec/pt-br/protocolos-clinicos-e-diretrizes-terapeuticas",
]
ALLOW = (".gov.br",)
PADRAO_PDF = re.compile(r"\.pdf($|\?)", re.I)
PADRAO_TEMA = re.compile(
    r"protocolo|diretriz|pcdt|atencao-basica|linhas-de-cuidado|guia", re.I
)


def catalogo_apidadosabertos(tema="saude", linhas=50):
    """Descobre datasets na API oficial do Dados Abertos do SUS (se disponível)."""
    url = f"https://apidadosabertos.saude.gov.br/datasets?tema={tema}&limit={linhas}"
    try:
        data = json.loads(fetch(url, allowlist=ALLOW))
        registros = data if isinstance(data, list) else data.get("results", data.get("datasets", []))
        return [(r.get("url") or r.get("link") or "", r.get("titulo") or r.get("title") or "")
                for r in registros][:linhas]
    except (RuntimeError, ValueError, KeyError):
        return []


def coletar(max_docs, com_api):
    d = fonte_dir("sus-protocolos")
    baixados, pulados, erros = 0, 0, []
    vistos = set()

    def baixa(url, titulo):
        nonlocal baixados, pulados
        if url in vistos or baixados >= max_docs:
            return
        vistos.add(url)
        try:
            path, novo = fetch_pdf_doc("sus-protocolos", url, titulo, allowlist=ALLOW)
            baixados += 1 if novo else 0
            pulados += 0 if novo else 1
            time.sleep(PAUSE_S)
        except (RuntimeError, ValueError) as e:
            erros.append(f"{url[:100]}: {e}")

    def varre(url, prof):
        if url in vistos or prof > 2 or baixados >= max_docs:
            return
        vistos.add(url)
        try:
            html = fetch(url, allowlist=ALLOW)
        except RuntimeError as e:
            erros.append(f"{url[:100]}: {e}")
            return
        for pdf_url, titulo in extrair_links(html, PADRAO_PDF, base_url=url):
            if PADRAO_TEMA.search(pdf_url + " " + titulo):
                baixa(pdf_url, titulo)
                if baixados >= max_docs:
                    return
        for sub, _ in extrair_links(html, PADRAO_TEMA, base_url=url):
            if not PADRAO_PDF.search(sub):
                varre(sub, prof + 1)
                if baixados >= max_docs:
                    return

    for semente in SEMENTES:
        varre(semente, 1)
        if baixados >= max_docs:
            break

    if com_api:
        for url, titulo in catalogo_apidadosabertos():
            if url and PADRAO_PDF.search(url):
                baixa(url, titulo)
            if baixados >= max_docs:
                break
    print(f"sus-protocolos: {baixados} novos, {pulados} já presentes, {len(erros)} erros → {d}")
    for e in erros[:20]:
        print(f"  ERRO {e}")
    return 0 if baixados or pulados else 1


if __name__ == "__main__":
    ap = argparse.ArgumentParser()
    ap.add_argument("--max", type=int, default=800)
    ap.add_argument("--com-api", action="store_true")
    a = ap.parse_args()
    sys.exit(coletar(a.max, a.com_api))
